# Non-secret Auth0 identifiers required by convex/auth.config.ts.
# Replace placeholders locally; do not commit real deployment values.
AUTH0_ISSUER=https://YOUR_AUTH0_DOMAIN/
AUTH0_NATIVE_CLIENT_ID=YOUR_NATIVE_CLIENT_ID
AUTH0_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID

# LiveKit server settings. These values are read only by Convex Node actions.
# Keep the API key and secret in Convex server environment variables, never in
# an iOS/browser client or a checked-in .env file.
LIVEKIT_URL=wss://YOUR_LIVEKIT_HOST
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# Configure LiveKit's webhook destination to the actual HTTPS Convex .site URL:
# https://YOUR_CONVEX_DEPLOYMENT.convex.site/livekit/webhook
# The URL above is documentation only; obtain the real deployment URL after
# connecting this project to its Convex deployment. Do not invent one.

# R3 Gemini vision backend
# Copy to backend/.env (ignored by Git) or export in the shell. Never commit a real key.
GEMINI_API_KEY=
# Required; there is no default. Pick a model your key can use, and check its pricing first.
GEMINI_MODEL=gemini-3.8-flash
# Optional
GEMINI_TIMEOUT_S=5
# Optional: low, medium or high for models that support thinkingLevel (such as 3.8 Flash).
# Leave blank for models that do not support it. This does not change the timeout or model.
GEMINI_THINKING_LEVEL=high

# Native R3 bridge. Configure the URL and token on Convex; configure the same token
# on the Python service. Keep the token server-side, never in iOS/browser settings.
# Set URL to the deployed HTTPS endpoint ending in /v1/read-screen.
R3_VISION_URL=
R3_VISION_SERVICE_TOKEN=
# Python service binds loopback; an HTTPS reverse proxy forwards to this port.
R3_PORT=8787
